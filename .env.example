LLT_AUTOMATION_ENABLED=false
LLT_MODE=test
LLT_AUTOMATION_START_AT=2026-11-13T00:00:00Z
LLT_SITE_URL=https://lovelettertales.com
LLT_FROM_EMAIL=Love Letter Tales <gifts@lovelettertales.com>
LLT_OWNER_EMAIL=kerrygoodearl@outlook.com
